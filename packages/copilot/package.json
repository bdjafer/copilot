{
  "name": "@astrale-os/browser-copilot",
  "version": "0.0.0",
  "description": "A generic browser LLM agent runtime: trigger/listen, host-registered typed tools, and a durable run queue that survives service-worker death. DOM-free.",
  "keywords": [
    "agent",
    "ai-sdk",
    "browser",
    "durable-queue",
    "extension",
    "llm",
    "mv3",
    "service-worker",
    "tool-calling",
    "typescript"
  ],
  "homepage": "https://github.com/astrale-os/exp-spec/tree/main/packages/copilot#readme",
  "bugs": {
    "url": "https://github.com/astrale-os/exp-spec/issues"
  },
  "license": "Apache-2.0",
  "author": "Astrale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/exp-spec.git",
    "directory": "packages/copilot"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/types/testing/index.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "BUILD_TARGET=iife vite build && vite build && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "ai": "^7.0.127",
    "nanoid": "^6.0.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
