{
  "name": "@astrale-os/comment-ui",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "author": "Astrale",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/comment-ui.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/comment-ui.css"
    }
  },
  "scripts": {
    "build": "BUILD_TARGET=iife vite build && vite build && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrale-os/comment-core": "workspace:*",
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
