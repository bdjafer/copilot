{
  "name": "@astrale-os/comment-ui",
  "version": "0.0.0",
  "description": "The renderer for @astrale-os/comment-core: badges, a composer popover, a thread popover and a corner panel in one open shadow root. No framework, and it never mutates the host page's DOM.",
  "keywords": [
    "annotations",
    "comments",
    "floating-ui",
    "overlay",
    "popover",
    "shadow-dom",
    "typescript",
    "ui",
    "vanilla"
  ],
  "homepage": "https://github.com/astrale-os/exp-spec/tree/main/packages/comment-ui#readme",
  "bugs": {
    "url": "https://github.com/astrale-os/exp-spec/issues"
  },
  "license": "Apache-2.0",
  "author": "Astrale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/exp-spec.git",
    "directory": "packages/comment-ui"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./presentation": "./src/presentation.ts",
    "./glass": "./src/glass.ts",
    "./testing": "./src/testing/index.ts",
    "./styles.css": "./dist/comment-ui.css",
    "./glass.css": "./dist/comment-ui-glass.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./presentation": {
        "types": "./dist/types/presentation.d.ts",
        "import": "./dist/presentation.js"
      },
      "./glass": {
        "types": "./dist/types/glass.d.ts",
        "import": "./dist/glass.js"
      },
      "./testing": {
        "types": "./dist/types/testing/index.d.ts",
        "import": "./dist/testing.js"
      },
      "./styles.css": "./dist/comment-ui.css",
      "./glass.css": "./dist/comment-ui-glass.css"
    }
  },
  "scripts": {
    "build": "BUILD_TARGET=iife vite build && BUILD_TARGET=glass vite build && vite build && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrale-os/comment-core": "workspace:*",
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
