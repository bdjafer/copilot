{
  // `.wxt/tsconfig.json` is regenerated by `wxt prepare` (which `pnpm typecheck` runs first).
  // It supplies the WXT globals (`defineBackground`, `defineContentScript`, `browser`, …), the
  // `@/` path aliases and the MV3-appropriate `lib`. It is NOT `tsconfig.base.json`: this
  // package is built by WXT/vite, not by the shared library pipeline, and it must compile
  // against WXT's generated ambient types. The flags below re-add the two repo-wide strictness
  // settings `.wxt/tsconfig.json` omits, so the extension is held to the same bar as the
  // libraries it bridges.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  }
}
