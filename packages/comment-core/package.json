{
  "name": "@astrale-os/comment-core",
  "version": "0.0.0",
  "description": "Persistent, re-anchorable comment threads on any element of any HTML page: flat replies, resolve/reopen, robust to a dynamic DOM. Headless — no framework, no server, no renderer.",
  "keywords": [
    "anchoring",
    "annotations",
    "comments",
    "dom",
    "headless",
    "selector",
    "shadow-dom",
    "typescript",
    "web-annotation"
  ],
  "homepage": "https://github.com/astrale-os/exp-spec/tree/main/packages/comment-core#readme",
  "bugs": {
    "url": "https://github.com/astrale-os/exp-spec/issues"
  },
  "license": "Apache-2.0",
  "author": "Astrale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/exp-spec.git",
    "directory": "packages/comment-core"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./headless": "./src/headless.ts",
    "./anchor": "./src/anchor/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./headless": {
        "types": "./dist/types/headless.d.ts",
        "import": "./dist/headless.js"
      },
      "./anchor": {
        "types": "./dist/types/anchor/index.d.ts",
        "import": "./dist/anchor.js"
      },
      "./testing": {
        "types": "./dist/types/testing/index.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "BUILD_TARGET=iife vite build && vite build && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@medv/finder": "^4.0.2",
    "approx-string-match": "^2.0.0",
    "nanoid": "^6.0.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "happy-dom": "^20.11.6"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
