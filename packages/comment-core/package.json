{
  "name": "@astrale-os/comment-core",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "author": "Astrale",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./headless": "./src/headless.ts",
    "./anchor": "./src/anchor/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./headless": {
        "types": "./dist/types/headless.d.ts",
        "import": "./dist/headless.js"
      },
      "./anchor": {
        "types": "./dist/types/anchor/index.d.ts",
        "import": "./dist/anchor.js"
      },
      "./testing": {
        "types": "./dist/types/testing/index.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "BUILD_TARGET=iife vite build && vite build && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@medv/finder": "^4.0.2",
    "approx-string-match": "^2.0.0",
    "nanoid": "^6.0.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "happy-dom": "^20.11.1"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    }
  }
}
